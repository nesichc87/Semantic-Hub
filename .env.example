# Copy this file to .env and adjust the values. .env is not part of the repository.

# Password of the catalog database. It is used inside a URL, so do not use
# the characters @ : / ? # % in it.
POSTGRES_PASSWORD=change-me

# Host port of the Semantic Hub (default 8000).
SEMANTIC_HUB_PORT=8000

# Seed sources to activate at the first start (comma-separated IDs, see
# docs/development.md). Setting it confirms their licenses. Empty: none.
SEMANTIC_HUB_SEED_SOURCES=